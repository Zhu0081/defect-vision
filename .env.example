# 复制一份改名为 .env 就能用（.env 不会进 git）
#
#   Copy-Item .env.example .env
#
# 不建 .env 也能跑 —— docker-compose.yml 里每项都有默认值。

# ---------- 数据库 ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=defect

# ---------- 应用 ----------
# 默认置信度阈值。产线上通常从 0.25 起调，
# 具体值看 reports/threshold_sweep.md 的漏检/过杀权衡。
DV_DEFAULT_CONF=0.25

# 上传大小上限（MB）
DV_MAX_UPLOAD_MB=16

# 模型文件路径（容器内路径）
DV_MODEL_PATH=/app/models/best.onnx

# ---------- 大模型（AI 报告）----------
# 走 OpenAI 兼容协议，换服务商只改这三行。
# 不填 KEY 也能跑：报告会自动降级成规则模板，接口返回 source=template。
#
# DeepSeek   https://api.deepseek.com/v1        deepseek-chat
# 通义千问    https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
# 智谱       https://open.bigmodel.cn/api/paas/v4   glm-4-flash
# 本地 Ollama http://host.docker.internal:11434/v1   qwen2.5:7b
#
# ⚠ KEY 只能写在 .env 里，而 .env 在 .gitignore 中。
#   把 key 硬编码进代码、或者提交到仓库，是这类项目最常见的翻车方式。
DV_LLM_BASE_URL=https://api.deepseek.com/v1
DV_LLM_API_KEY=
DV_LLM_MODEL=deepseek-chat
DV_LLM_TIMEOUT_S=20
DV_LLM_MAX_TOKENS=700
