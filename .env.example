# 复制一份改名为 .env 就能用（.env 不会进 git）
#
#   Copy-Item .env.example .env
#
# 不建 .env 也能跑 —— docker-compose.yml 里每项都有默认值。

# ---------- 数据库 ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=defect

# ---------- 应用 ----------
# 默认置信度阈值。产线上通常从 0.25 起调，
# 具体值看 reports/threshold_sweep.md 的漏检/过杀权衡。
DV_DEFAULT_CONF=0.25

# 上传大小上限（MB）
DV_MAX_UPLOAD_MB=16

# 模型文件路径（容器内路径）
DV_MODEL_PATH=/app/models/best.onnx
